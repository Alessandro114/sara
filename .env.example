# === Database ===
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sara

# === AI Providers (at least one required) ===
GROQ_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
MISTRAL_API_KEY=

# === WhatsApp (WAHA) ===
WAHA_API_URL=http://127.0.0.1:3004
WAHA_API_KEY=your-waha-api-key
WAHA_ENGINE=GOWS
WAHA_WEBHOOK_URL=http://127.0.0.1:3006/api/waha-webhook

# === SARA API ===
SARA_API_KEY=change-this-to-a-secure-key
SARA_API_PORT=3006

# === Optional: SCALA Backend (for CRM sync) ===
SCALA_BACKEND_URL=
SCALA_API_KEY=

# === Optional: Telegram Alerts ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# === Optional: Sentry ===
SENTRY_DSN=

# === Optional: Tavily (web search, enterprise only) ===
TAVILY_API_KEY=

# === Optional: Paths ===
SARA_KB_PATH=./src/data/sara-kb.md
PDF_CSS_PATH=./assets/doc-style-dark.css
PDF_RENDERER_PATH=./scripts/render-pdf.js
SARA_MONITOR_LOG_DIR=./logs/sara-monitor
