{
  "name": "scala-whatsapp-bot",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "preflight": "node scripts/preflight.js",
    "clear-crash-loop": "rm -f .crash_history.json .wa_paused && echo 'crash loop state cleared'",
    "test": "./scripts/run-tests.sh",
    "postinstall": "npx patch-package --patch-dir patches"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "dotenv": "^17.3.1",
    "fastify": "^5.3.3",
    "pdf-parse": "^1.1.1",
    "pg": "^8.16.0",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.2",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.19.4",
    "typescript": "~5.9.3"
  },
  "license": "Apache-2.0"
}
